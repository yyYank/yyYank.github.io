---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FadeIn, StaggerContainer, StaggerItem, HoverCard } from '../components/Motion';

import { NAV_PAGES } from '../lib/navVisibility';

const pageLinks = [
  ...NAV_PAGES,
  { href: '/config/', icon: '⚙️', label: 'Config' },
];
---

<BaseLayout title="yankなページ">
  <div class="container mx-auto px-4 py-16">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-5xl font-bold mb-4 overflow-hidden">
        <span class="marquee-text inline-block bg-gradient-to-r from-accent-cyan via-accent-purple to-accent-pink bg-clip-text text-transparent">yankなページ</span>
      </h1>
      <FadeIn delay={0.2} client:visible>
        <a
          href="/profile/"
          class="inline-block mt-3 text-sm text-accent hover:text-accent-purple transition-colors underline underline-offset-4"
        >
          about me →
        </a>
      </FadeIn>

      <StaggerContainer className="mt-12 grid grid-cols-2 sm:grid-cols-3 gap-3" client:visible>
        {pageLinks.map((item) => (
          <StaggerItem className="nav-cell">
            <HoverCard client:visible>
              <a
                href={item.href}
                data-nav-href={item.href}
                class="block p-4 bg-surface border border-border rounded-lg text-muted hover:text-accent hover:border-accent/40 transition-colors"
              >
                <span class="mr-1.5">{item.icon}</span>{item.label}
              </a>
            </HoverCard>
          </StaggerItem>
        ))}
      </StaggerContainer>
    </div>
  </div>
</BaseLayout>

<style>
  .marquee-text {
    animation: marquee 8s linear infinite;
  }
  @keyframes marquee {
    from { transform: translateX(100vw); }
    to { transform: translateX(-100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-text { animation: none; }
  }
</style>
