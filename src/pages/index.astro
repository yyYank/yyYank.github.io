---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageLinks = [
  { href: '/kotlin-rev/', icon: '📖', label: '逆引きKotlin' },
  { href: '/docs/', icon: '📝', label: 'MEMO' },
  { href: '/feeds/', icon: '📰', label: 'Feeds' },
  { href: '/toolkit/', icon: '🧰', label: 'Toolkit' },
  { href: '/transient/', icon: '🗒️', label: 'Transient' },
  { href: '/defrag/', icon: '🧩', label: 'Defrag' },
  { href: '/diary/', icon: '📔', label: 'Diary' },
  { href: '/config/', icon: '⚙️', label: 'Config' },
];
---

<BaseLayout title="yankなページ">
  <div class="container mx-auto px-4 py-16">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-5xl font-bold mb-4 overflow-hidden">
        <span class="marquee-text inline-block bg-gradient-to-r from-accent-cyan via-accent-purple to-accent-pink bg-clip-text text-transparent">yankなページ</span>
      </h1>
      <a
        href="/profile/"
        class="inline-block mt-3 text-sm text-accent-cyan hover:text-accent-purple transition-colors underline underline-offset-4"
      >
        about me →
      </a>

      <nav class="mt-12 grid grid-cols-2 sm:grid-cols-3 gap-3" aria-label="ページ一覧">
        {pageLinks.map((item) => (
          <a
            href={item.href}
            class="block p-4 bg-dark-800 border border-dark-600 rounded-lg text-gray-300 hover:text-accent-cyan hover:border-accent-cyan/40 transition-all"
          >
            <span class="mr-1.5">{item.icon}</span>{item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .marquee-text {
    animation: marquee 8s linear infinite;
  }
  @keyframes marquee {
    from { transform: translateX(100vw); }
    to { transform: translateX(-100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-text { animation: none; }
  }
</style>
