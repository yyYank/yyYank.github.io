---
import BaseLayout from '../layouts/BaseLayout.astro';
import PasswordGenerator from '../components/random-pass/PasswordGenerator.tsx';
import CharCount from '../components/count/CharCount.tsx';
import ImagePaste from '../components/img-paste/ImagePaste.tsx';
import AudioConverter from '../components/sounds/AudioConverter.tsx';
import AudioMerger from '../components/sounds/AudioMerger.tsx';
import AudioTrimmer from '../components/sounds/AudioTrimmer.tsx';
import AudioVolumeChanger from '../components/sounds/AudioVolumeChanger.tsx';
import MovieTrimmer from '../components/movie/MovieTrimmer.tsx';
import MovToMp4Converter from '../components/movie/MovToMp4Converter.tsx';
import OcrTool from '../components/ocr/OcrTool.astro';

const groups = [
  {
    label: '映像・音声・画像',
    tabs: [
      { id: 'movie', icon: '🎬', label: 'Movie' },
      { id: 'audio', icon: '🎵', label: 'Audio' },
      { id: 'img-paste', icon: '🖼️', label: 'Image Paste' },
    ],
  },
  {
    label: '文字・テキスト',
    tabs: [
      { id: 'ocr', icon: '📝', label: 'OCR' },
      { id: 'count', icon: '🔢', label: 'Count' },
      { id: 'random-pass', icon: '🔑', label: 'Random Pass' },
    ],
  },
];
---

<BaseLayout title="Toolkit" description="映像・音声・画像・テキストの各種ツール集">
  <script is:inline src="/coi-serviceworker.js"></script>
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <h1 class="text-3xl font-bold text-white mb-2">Toolkit</h1>
    <p class="text-gray-400 mb-8">映像・音声・画像・テキストのツール集</p>

    <div class="flex flex-col sm:flex-row gap-4 mb-8" role="tablist" aria-label="ツール切り替え">
      {groups.map((group) => (
        <div class="flex-1 bg-dark-800/60 border border-dark-600 rounded-lg p-3">
          <div class="text-xs text-gray-500 mb-2">{group.label}</div>
          <div class="flex gap-2 flex-wrap">
            {group.tabs.map((t) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected="false"
                data-toolkit-tab={t.id}
                class="toolkit-tab px-3 py-2 rounded-lg text-sm font-medium transition-all bg-dark-700 text-gray-400 border border-dark-600 hover:text-gray-200 hover:border-dark-500"
              >
                <span class="mr-1.5">{t.icon}</span>{t.label}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <section id="panel-random-pass" role="tabpanel" aria-labelledby="tab-random-pass" data-toolkit-panel="random-pass" hidden>
      <h2 class="text-2xl font-bold text-white mb-2">Random Pass</h2>
      <p class="text-gray-400 mb-8">ランダムパスワード生成</p>
      <PasswordGenerator client:load />
    </section>

    <section id="panel-count" role="tabpanel" aria-labelledby="tab-count" data-toolkit-panel="count" hidden>
      <h2 class="text-2xl font-bold text-white mb-2">Count</h2>
      <p class="text-gray-400 mb-8">文字数カウント</p>
      <CharCount client:load />
    </section>

    <section id="panel-img-paste" role="tabpanel" aria-labelledby="tab-img-paste" data-toolkit-panel="img-paste" hidden>
      <h2 class="text-2xl font-bold text-white mb-2">Image Paste</h2>
      <p class="text-gray-400 mb-8">クリップボードから画像をペーストして保存</p>
      <ImagePaste client:load />
    </section>

    <section id="panel-audio" role="tabpanel" aria-labelledby="tab-audio" data-toolkit-panel="audio" hidden>
      <h2 class="text-2xl font-bold text-white mb-2">Audio Tool</h2>
      <p class="text-gray-400 mb-8">音声変換・連結・トリミング・音量調整ツール — ブラウザ内で処理（サーバー不要）</p>
      <div class="grid md:grid-cols-2 gap-6">
        <AudioConverter client:load />
        <AudioMerger client:load />
        <AudioVolumeChanger client:load />
      </div>
      <div class="mt-6">
        <AudioTrimmer client:load />
      </div>
      <p class="mt-6 text-xs text-gray-600">
        処理はすべてブラウザ内で行われます。ファイルはサーバーに送信されません。<br />
        初回ロード時に ffmpeg.wasm（約30MB）をダウンロードします。
      </p>
    </section>

    <section id="panel-movie" role="tabpanel" aria-labelledby="tab-movie" data-toolkit-panel="movie" hidden>
      <h2 class="text-2xl font-bold text-white mb-2">Movie Tool</h2>
      <p class="text-gray-400 mb-8">動画トリミングツール — ブラウザ内で処理（サーバー不要）</p>
      <MovieTrimmer client:load />
      <div class="mt-6">
        <MovToMp4Converter client:load />
      </div>
      <p class="mt-6 text-xs text-gray-600">
        処理はすべてブラウザ内で行われます。ファイルはサーバーに送信されません。<br />
        初回ロード時に ffmpeg.wasm（約30MB）をダウンロードします。
      </p>
    </section>
  </div>

  <section id="panel-ocr" role="tabpanel" aria-labelledby="tab-ocr" data-toolkit-panel="ocr" hidden>
    <OcrTool />
  </section>

  <script>
    const ACTIVE = ['bg-accent-cyan/20', 'text-accent-cyan', 'border-accent-cyan/40'];
    const INACTIVE = ['bg-dark-700', 'text-gray-400', 'border-dark-600', 'hover:text-gray-200', 'hover:border-dark-500'];
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-toolkit-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-toolkit-panel]'));
    const tabIds = tabs.map((t) => t.dataset.toolkitTab!);

    function activate(id: string, updateUrl: boolean) {
      tabs.forEach((t) => {
        const active = t.dataset.toolkitTab === id;
        t.setAttribute('aria-selected', String(active));
        t.classList.remove(...ACTIVE, ...INACTIVE);
        t.classList.add(...(active ? ACTIVE : INACTIVE));
      });
      panels.forEach((p) => { p.hidden = p.dataset.toolkitPanel !== id; });
      if (updateUrl) {
        const url = new URL(location.href);
        url.searchParams.set('tab', id);
        history.replaceState(null, '', url);
      }
    }

    tabs.forEach((t) => t.addEventListener('click', () => activate(t.dataset.toolkitTab!, true)));

    const requested = new URL(location.href).searchParams.get('tab') ?? '';
    activate(tabIds.includes(requested) ? requested : 'movie', false);
  </script>
</BaseLayout>
