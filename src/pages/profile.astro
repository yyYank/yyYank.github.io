---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TwitterIcon, GitHubIcon, BloggerIcon, HatenaIcon, BlogIcon, MemoIcon, PodcastIcon } from '../components/Icons';
import { TextSwitchAnimation } from '../components/Motion';
import { TechBadgeList } from '../components/TechBadge';
import PagesSection from '../components/PagesSection.tsx';
---

<BaseLayout title="Profile">
  <div class="container mx-auto px-4 py-16">
    <div class="max-w-4xl mx-auto">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <div class="relative inline-block mb-6">
          <div class="absolute inset-0 bg-accent-cyan/20 rounded-full blur-xl"></div>
          <img
            src="https://avatars3.githubusercontent.com/u/3250718?v=3&s=460"
            alt="yy_yank icon"
            class="relative w-32 h-32 rounded-full border-2 border-accent/50 shadow-glow-accent"
          />
        </div>
        <h1 class="text-5xl font-bold mb-4">
          <TextSwitchAnimation
            firstText=":"
            secondText="yy_yank"
            typingSequence={[':', ':q', ':q!']}
            secondTypingSequence={['y', 'yy', 'yy_', 'yy_y', 'yy_ya', 'yy_yan', 'yy_yank']}
            className="bg-gradient-to-r from-accent-cyan via-accent-purple to-accent-pink bg-clip-text text-transparent"
            duration={1}
            client:load
          />
        </h1>
        <p class="text-xl text-muted">Japanese 'Yurufuwa' Programmer</p>
        <p class="text-faint mt-2">CELLORB Inc.</p>
      </div>

      <!-- Tech Stack -->
      <div class="mb-16">
        <TechBadgeList techs={['Java', 'Kotlin', 'Go', 'Rust', 'TypeScript']} client:visible />
      </div>

      <!-- Links Grid -->
      <div class="grid md:grid-cols-2 gap-6 mb-16">
        <a
          href="https://twitter.com/yy_yank"
          target="_blank"
          rel="noopener noreferrer"
          class="block p-6 bg-surface border border-border rounded-xl hover:border-accent/50 hover:shadow-glow-accent transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98]"
        >
          <h3 class="text-lg font-semibold text-text hover:text-accent transition-colors mb-2 flex items-center gap-2">
            <TwitterIcon />
            Twitter
          </h3>
          <p class="text-muted">@yy_yank</p>
        </a>

        <a
          href="https://github.com/yyYank"
          target="_blank"
          rel="noopener noreferrer"
          class="block p-6 bg-surface border border-border rounded-xl hover:border-accent/50 hover:shadow-glow-accent transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98]"
        >
          <h3 class="text-lg font-semibold text-text hover:text-accent transition-colors mb-2 flex items-center gap-2">
            <GitHubIcon />
            GitHub
          </h3>
          <p class="text-muted">github.com/yyYank</p>
        </a>
      </div>

      <!-- Pages Section -->
      <PagesSection client:load />

      <!-- Blog Section -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
          <span class="w-8 h-0.5 bg-accent-green"></span>
          Blog
        </h2>
        <div class="space-y-4">
          <a
            href="https://yyyank.blogspot.jp/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-4 bg-surface/50 border border-border rounded-lg hover:bg-surface-2 transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98] group"
          >
            <span class="text-accent-green"><BloggerIcon /></span>
            <span class="text-muted group-hover:text-accent-green transition-colors">プログラマのはしくれダイアリー</span>
          </a>
          <a
            href="https://yy-yank.hatenablog.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-4 bg-surface/50 border border-border rounded-lg hover:bg-surface-2 transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98] group"
          >
            <span class="text-accent-green"><HatenaIcon /></span>
            <span class="text-muted group-hover:text-accent-green transition-colors">ヤンクの毛刈り</span>
          </a>
          <a
            href="https://sizu.me/yy_yank"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-4 bg-surface/50 border border-border rounded-lg hover:bg-surface-2 transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98] group"
          >
            <span class="text-accent-green"><BlogIcon /></span>
            <span class="text-muted group-hover:text-accent-green transition-colors">しずかなインターネット</span>
          </a>
          <a
            href="https://qiita.com/yyYank"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-4 bg-surface/50 border border-border rounded-lg hover:bg-surface-2 transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98] group"
          >
            <span class="text-accent-green"><BlogIcon /></span>
            <span class="text-muted group-hover:text-accent-green transition-colors">Qiita</span>
          </a>
          <a
            href="https://zenn.dev/yy_yank"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-4 bg-surface/50 border border-border rounded-lg hover:bg-surface-2 transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98] group"
          >
            <span class="text-accent-green"><BlogIcon /></span>
            <span class="text-muted group-hover:text-accent-green transition-colors">Zenn</span>
          </a>
        </div>
      </div>

      <!-- Podcast Section -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
          <span class="w-8 h-0.5 bg-accent-cyan"></span>
          <span class="text-accent"><PodcastIcon /></span>
          Podcast
        </h2>
        <div class="space-y-4">
          <a
            href="https://open.spotify.com/show/10oTV1GgG4GRfbLcwunpJU"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-4 bg-surface/50 border border-border rounded-lg hover:bg-surface-2 transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98] group"
          >
            <span class="text-accent"><BlogIcon /></span>
            <span class="text-muted group-hover:text-accent transition-colors">わいわいyankfm</span>
          </a>
        </div>
      </div>

      <!-- Contributions Section -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
          <span class="w-8 h-0.5 bg-accent-cyan"></span>
          Contributions
        </h2>
        <div class="space-y-4">
          <a
            href="https://drive.google.com/file/d/0Bylpznm149-gTGRjOFRkWm9PODg/view"
            target="_blank"
            rel="noopener noreferrer"
            class="block p-4 bg-surface/50 border border-border rounded-lg hover:bg-surface-2 transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98]"
          >
            <span class="text-muted hover:text-accent transition-colors">Kotlin助走読本</span>
          </a>
          <a
            href="https://www.amazon.co.jp/dp/B076Q2L1M6/ref=cm_sw_r_tw_awdo_c_x_LMA.BbPBEM027"
            target="_blank"
            rel="noopener noreferrer"
            class="block p-4 bg-surface/50 border border-border rounded-lg hover:bg-surface-2 transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98]"
          >
            <span class="text-muted hover:text-accent transition-colors">Kotlinイン・アクション</span>
          </a>
        </div>
      </div>

      <!-- Slides Section -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
          <span class="w-8 h-0.5 bg-accent-purple"></span>
          Slides
        </h2>
        <div class="grid md:grid-cols-2 gap-3">
          {[
            { url: 'https://www.slideshare.net/yyyank/server-side-kotlin-49030491', title: 'Server Side Kotlin' },
            { url: 'https://www.slideshare.net/yyyank/kotlinver', title: 'Kotlinメジャーver リリースを前に' },
            { url: 'https://www.slideshare.net/yyyank/java-55600699', title: 'Javaプログラマコーディングマイグレーション' },
            { url: 'https://www.slideshare.net/yyyank/kotlin-58781668', title: 'Kotlinあるある言いたい' },
            { url: 'https://www.slideshare.net/yyyank/kotlin-60377622', title: 'Kotlinこんなん出ましたけど' },
            { url: 'https://www.slideshare.net/yyyank/ss-62257220', title: '絶対にぬるぽを出さない' },
            { url: 'https://www.slideshare.net/yyyank/doma2-with-kotlin', title: 'Doma2 with Kotlin' },
            { url: 'https://www.slideshare.net/yyyank/kuromojikotlin', title: 'KuromojiをKotlinで動かす' },
            { url: 'https://www.slideshare.net/yyyank/javafizz-buzz', title: 'Javaで最強のfizz buzz' },
            { url: 'https://www.slideshare.net/yyyank/kotlin-69542943', title: 'Kotlinソースコード探訪' },
            { url: 'https://www.slideshare.net/yyyank/jvmjava-69784006', title: 'Jvm言語とJava、切っても切れないその関係' },
            { url: 'https://www.slideshare.net/yyyank/vm-dalvikartjava-vm', title: 'VMの歩む道。Dalvik、ART、そしてJava VM' },
            { url: 'https://www.slideshare.net/yyyank/javago', title: 'Javaプログラマのための頑張らないGo入門' },
            { url: 'https://speakerdeck.com/yyyank/sabasaidokotlintoiuxuan-ze-zhi-toyuzabesu', title: 'サーバーサイドKotlinという選択肢とユーザベース' },
            { url: 'https://speakerdeck.com/yyyank/debeziumdebian-geng-detakiyaputiyawoxue-bou-number-jjug-ccc', title: 'Debeziumで変更データキャプチャを学ぼう' },
          ].map(slide => (
            <a
              href={slide.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block p-3 text-sm bg-surface/50 border border-border rounded-lg text-muted hover:text-accent-purple hover:bg-surface-2 transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98] truncate"
            >
              {slide.title}
            </a>
          ))}
        </div>
      </div>

      <!-- Libraries Section -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
          <span class="w-8 h-0.5 bg-accent-green"></span>
          Libraries
        </h2>
        <div class="flex flex-wrap gap-4">
          {[
            { url: 'https://github.com/yyYank/Kebab', name: 'Kebab' },
            { url: 'https://github.com/skrap-json4k/skrap-json4k', name: 'json4k' },
            { url: 'https://github.com/yyYank/goodbye', name: 'goodbye' },
          ].map(lib => (
            <a
              href={lib.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block px-6 py-3 bg-surface-2 border border-border-strong rounded-lg text-accent-green hover:bg-accent-soft transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98] font-mono"
            >
              {lib.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Tool Section -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
          <span class="w-8 h-0.5 bg-accent-cyan"></span>
          Tool
        </h2>
        <a
          href="https://github.com/yyYank/playwright-blockly"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-6 py-3 bg-surface-2 border border-border-strong rounded-lg text-accent hover:bg-accent-soft transition duration-fast ease-ui hover:-translate-y-px active:scale-[.98] font-mono"
        >
          playwright-blockly
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
