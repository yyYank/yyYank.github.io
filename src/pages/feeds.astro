---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FadeIn } from '../components/Motion';
import FeedReader from '../components/feeds/FeedReader.tsx';
---

<BaseLayout title="Feeds" description="ニュース・技術記事フィード">
  <div class="container mx-auto px-4 py-8 max-w-4xl">
    <FadeIn client:visible>
      <h1 class="text-3xl font-bold text-text mb-2"><span class="inline-block" style="view-transition-name: nav-feeds">Feeds</span></h1>
      <p class="text-muted mb-8">技術ニュース・記事まとめ</p>
    </FadeIn>
    <FeedReader client:load />
  </div>
</BaseLayout>
