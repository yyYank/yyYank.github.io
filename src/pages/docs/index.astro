---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';
import { isTopLevelIndexId } from '../../lib/content';

const allDocs = (await getCollection('docs')).filter((doc) => !isTopLevelIndexId(doc.id));
const sortedDocs = allDocs.sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));
---

<DocsLayout title="Overview">
  <h1>Overview</h1>
  <h2>memoリンク</h2>
  <p>たまーにしか使わないやつか、よく忘れるやつのメモになる予定</p>

  <div class="grid gap-4 mt-8 not-prose">
    {sortedDocs.map(doc => (
      <a
        href={`/docs/${doc.id}/`}
        class="block p-4 bg-surface rounded-lg hover:bg-surface-2 transition-colors no-underline border border-border hover:border-accent/50"
      >
        <h3 class="text-lg font-semibold text-text mb-1">{doc.data.title}</h3>
        {doc.data.description && (
          <p class="text-muted text-sm">{doc.data.description}</p>
        )}
      </a>
    ))}
  </div>
</DocsLayout>
