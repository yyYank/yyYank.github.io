---
import type { CollectionEntry } from 'astro:content';

interface Props {
  docs: CollectionEntry<'kotlinrev'>[];
  currentSlug?: string;
}

const { docs, currentSlug } = Astro.props;
---

<nav class="bg-surface border border-border rounded-lg p-4">
  <h4 class="font-bold text-text mb-4">逆引きKotlin</h4>
  <ul class="space-y-2">
    {docs.map(doc => (
      <li>
        <a
          href={`/kotlin-rev/${doc.id}/`}
          class:list={[
            'block py-2 px-3 rounded-lg transition-colors text-sm',
            currentSlug === doc.id
              ? 'bg-accent-cyan/10 text-accent border border-accent/30'
              : 'text-muted hover:text-text hover:bg-surface-2'
          ]}
        >
          {doc.data.title}
        </a>
      </li>
    ))}
  </ul>
</nav>
