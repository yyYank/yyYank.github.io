---
import type { CollectionEntry } from 'astro:content';

interface Props {
  docs: CollectionEntry<'docs'>[];
  currentSlug?: string;
  plain?: boolean;
}

const { docs, currentSlug, plain = false } = Astro.props;
---

<nav class:list={[plain ? 'p-2' : 'bg-surface border border-border rounded-lg p-4']}>
  {!plain && <h4 class="font-bold text-text mb-4">Docs</h4>}
  <ul class="space-y-2">
    {docs.map(doc => (
      <li>
        <a
          href={`/docs/${doc.id}/`}
          class:list={[
            'block py-2 px-3 rounded-lg transition-colors text-sm',
            currentSlug === doc.id
              ? 'bg-accent-cyan/10 text-accent border border-accent/30'
              : 'text-muted hover:text-text hover:bg-surface-2'
          ]}
        >
          {doc.data.title}
        </a>
      </li>
    ))}
  </ul>
</nav>
